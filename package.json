{
  "name": "eju-score-tracker",
  "private": true,
  "version": "1.2.1",
  "description": "EJU 모의고사 점수 관리 앱",
  "author": "이강민 (Lee Kangmin) <leekangmmin@github>",
  "license": "MIT",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekangmmin/EJUScore.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:icons": "node scripts/generate-icons.js",
    "build:electron": "npm run build:icons && vite build --mode electron",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build:win": "npm run build:electron && electron-builder --win",
    "electron:build:linux": "npm run build:electron && electron-builder --linux",
    "electron:build:mac": "npm run build:electron && electron-builder --mac",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "build": {
    "appId": "com.ejuscore.app",
    "productName": "EJU Score Tracker",
    "copyright": "Copyright © 2025 이강민 (Lee Kangmin)",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/icon-512.png",
      "public/icon.ico"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon-512.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "mac": {
      "icon": "public/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "dmg": {
      "title": "EJU Score Tracker",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon-512.png",
      "installerHeaderIcon": "public/icon-512.png"
    }
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "png-to-ico": "^3.0.1",
    "vite": "^8.0.10"
  }
}
