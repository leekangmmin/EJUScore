{
  "name": "eju-score-tracker",
  "private": true,
  "version": "1.3.9",
  "description": "EJU Exam Score Tracker — Mock Exam Management App",
  "author": "Lee Kangmin <leekangmmin@github>",
  "license": "MIT",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekangmmin/EJUScore.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:icons": "node scripts/generate-icons.js",
    "build:electron": "npm run build:icons && vite build --mode electron",
    "electron:dev": "npm run build:electron && ELECTRON_RUN_AS_NODE= electron .",
    "electron:build:win": "npm run build:electron && electron-builder --win",
    "electron:build:linux": "npm run build:electron && electron-builder --linux",
    "electron:build:mac": "npm run build:electron && ELECTRON_RUN_AS_NODE= electron-builder --mac",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "build": {
    "appId": "com.ejuscore.app",
    "productName": "EJU Score Tracker",
    "copyright": "Copyright © 2025 이강민 (Lee Kangmin)",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.js",
      "electron/preload.cjs",
      "electron/aiWorker.js",
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "public/icon-512.png",
      "public/icon.ico"
    ],
    "asarUnpack": [
      "dist/tesseract/**"
    ],
    "win": {
      "icon": "public/icon-512.png",
      "publisherName": "Lee Kangmin",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon-512.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "mac": {
      "icon": "public/icon-1024.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "dmg": {
      "title": "EJU Score Tracker",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true
    }
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@hyzyla/pdfium": "^2.1.13",
    "framer-motion": "^12.39.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^5.7.284",
    "pretendard": "^1.3.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "png-to-ico": "^3.0.1",
    "vite": "^8.0.10"
  }
}
